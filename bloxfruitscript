local espBillboards = {}

local RARE_FRUITS = {
    "Dragon","Leopard","Dough","Shadow","Blizzard","Venom","Soul",
    "Control","Spirit","Buddha","Phoenix","Rumble","String","Gravity",
    "Magma","Dark","Light","Revive","Ghost","Tiger","Hellfire"
