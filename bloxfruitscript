                bb:Destroy()
                espBillboards[fruit] = nil
            end
        end
        if _G.BH_FruitESP and getChar() then
            local folder = workspace:FindFirstChild("Fruits")
                        or workspace:FindFirstChild("GameItems")
            if folder then
                for _, fruit in ipairs(folder:GetDescendants()) do
                    if fruit:IsA("BasePart") and not espBillboards[fruit] then
                        local bb = Instance.new("BillboardGui", fruit)
                        bb.AlwaysOnTop = true
                        bb.Size        = UDim2.new(0, 100, 0, 30)
                        bb.StudsOffset = Vector3.new(0, 3, 0)
                        local lbl = Instance.new("TextLabel", bb)
                        lbl.Size              = UDim2.new(1,0,1,0)
                        lbl.BackgroundTransparency = 1
                        lbl.Text              = "🍈 " .. fruit.Parent.Name
                        lbl.TextColor3        = isRare(fruit.Parent.Name) and C.spy or C.accent2
                        lbl.Font              = Enum.Font.GothamBold
                        lbl.TextSize          = 12
                        espBillboards[fruit]  = bb

                        if isRare(fruit.Parent.Name) then
                            game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
                                Text      = "[BloxHub] 🍈 RARE FRUIT: " .. fruit.Parent.Name,
                                Color     = C.spy,
                                Font      = Enum.Font.GothamBold,
                                TextSize  = 14,
                            })
                        end
                    end
                    -- Update distance label
                    if espBillboards[fruit] and getChar() then
                        local lbl2 = espBillboards[fruit]:FindFirstChildOfClass("TextLabel")
                        if lbl2 then
                            local d = math.floor((hrp.Position - fruit.Position).Magnitude)
                            lbl2.Text = "🍈 " .. fruit.Parent.Name .. "  [" .. d .. "m]"
                        end
                    end
                end
            end
