_G.BH_SpyCallback = function(entry)
    SpyEntryCount = SpyEntryCount + 1
    local row = Instance.new("TextLabel", SpyScroll)
    row.LayoutOrder      = -SpyEntryCount  -- newest on top
    row.Size             = UDim2.new(1, -6, 0, 18)
    row.BackgroundTransparency = 1
    row.TextColor3       = entry.type == "InvokeServer" and C.spy or C.accent2
    row.Font             = Enum.Font.Code
    row.TextSize         = 10
    row.TextXAlignment   = Enum.TextXAlignment.Left
    row.TextWrapped      = false
    row.ClipsDescendants = true

    -- Format args safely
    local argStr = ""
    for i, v in ipairs(entry.args) do
        local ok, s = pcall(tostring, v)
        argStr = argStr .. (ok and s or "?")
        if i < #entry.args then argStr = argStr .. ", " end
    end
    if #argStr > 60 then argStr = argStr:sub(1,60) .. "…" end

    row.Text = string.format("[%.2f] %s:%s(%s)", entry.time, entry.name, entry.type, argStr)

    -- Trim to 150 visible rows in the scroll
    if SpyEntryCount > 150 then
        local children = SpyScroll:GetChildren()
        for _, c in ipairs(children) do
            if c:IsA("TextLabel") then c:Destroy(); break end
        end
    end
end

