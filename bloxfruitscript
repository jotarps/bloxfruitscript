-- ── Helpers ─────────────────────────────────────────────────
local function getChar()
    char = plr.Character
    if char then
        hrp = char:FindFirstChild("HumanoidRootPart")
        hum = char:FindFirstChild("Humanoid")
    end
    return char and hrp and hum
end

local function invokeCommF(...)
    if not CommF_ then return nil end
    local ok, res = pcall(function(...) return CommF_:InvokeServer(...) end, ...)
    if ok then return res end
    return nil
end

local function getEnemies()
    local enemies = {}
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return enemies end
    for _, v in ipairs(folder:GetChildren()) do
        local h = v:FindFirstChildOfClass("Humanoid")
        local r = v:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 then
            table.insert(enemies, v)
        end
    end
    return enemies
end

local function getClosestEnemy(range)
    if not getChar() then return nil end
    local closest, dist = nil, range or math.huge
    for _, v in ipairs(getEnemies()) do
        local r = v:FindFirstChild("HumanoidRootPart")
        if r then
            local d = (hrp.Position - r.Position).Magnitude
            if d < dist then closest, dist = v, d end
        end
    end
    return closest
end

local function tpTo(cf)
    if not getChar() then return end
    hrp.CFrame = cf
end

local function attackNearest()
    local enemy = getClosestEnemy(60)
    if enemy then
        local tool = plr.Character:FindFirstChildOfClass("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                -- Simulate tool activation via RemoteEvent
                local remote = tool:FindFirstChildOfClass("RemoteEvent")
                    or tool:FindFirstChildOfClass("RemoteFunction")
                if remote then pcall(function() remote:FireServer() end) end
            end
        end
        -- Move near enemy
        if enemy:FindFirstChild("HumanoidRootPart") then
            tpTo(enemy.HumanoidRootPart.CFrame * CFrame.new(0,0,5))
        end
    end
end

