local function isRare(name)
    for _, r in ipairs(RARE_FRUITS) do
        if name:find(r) then return true end
    end
    return false
end

spawn(function()
    while true do
        wait(1)
        -- Clear stale
        for fruit, bb in pairs(espBillboards) do
