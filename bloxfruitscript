local function makeTab(name, icon, order)
    local btn = Instance.new("TextButton", TabBar)
    btn.Name              = name
    btn.LayoutOrder       = order
    btn.Size              = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3  = C.bg
    btn.Text              = icon .. "  " .. name
    btn.TextColor3        = C.textDim
    btn.Font              = Enum.Font.Gotham
    btn.TextSize          = 12
    btn.TextXAlignment    = Enum.TextXAlignment.Left
    btn.BorderSizePixel   = 0

    local pad = Instance.new("UIPadding", btn)
    pad.PaddingLeft = UDim.new(0, 10)

    local sel = Instance.new("Frame", btn)
    sel.Name             = "Sel"
    sel.Size             = UDim2.new(0, 3, 1, 0)
    sel.Position         = UDim2.new(0, 0, 0, 0)
    sel.BackgroundColor3 = C.accent
    sel.BorderSizePixel  = 0
    sel.Visible          = false

    -- Page
    local page = Instance.new("ScrollingFrame", ContentArea)
    page.Name              = name
    page.Size              = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel   = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = C.accent
    page.CanvasSize        = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible           = false

    local listLayout = Instance.new("UIListLayout", page)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding   = UDim.new(0, 6)
    local pagePad = Instance.new("UIPadding", page)
    pagePad.PaddingTop    = UDim.new(0, 8)
    pagePad.PaddingLeft   = UDim.new(0, 8)
    pagePad.PaddingRight  = UDim.new(0, 8)

    btn.MouseButton1Click:Connect(function()
        if activeTab then
            activeTab.TextColor3    = C.textDim
            activeTab:FindFirstChild("Sel").Visible = false
        end
        if activePage then activePage.Visible = false end
        activeTab, activePage = btn, page
        btn.TextColor3 = C.accent2
        sel.Visible    = true
        page.Visible   = true
    end)

    return btn, page
end

