--  REMOTE SPY MODULE
-- ============================================================
local RemoteSpy = {}
RemoteSpy.Log   = {}   -- { time, remote, type, args }
RemoteSpy.Max   = 500  -- max entries before rolling

local function hookRemotes()
    -- Patch RemoteFunction:InvokeServer and RemoteEvent:FireServer via __namecall
    local mt = getrawmetatable and getrawmetatable(game)
    if not mt then return end   -- executor doesn't expose metatable → spy disabled silently

    local old_namecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        local args   = {...}
        if (method == "FireServer" or method == "InvokeServer") and
           (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
            -- Log entry
            local entry = {
                time   = os.clock(),
                name   = self.Name,
                path   = self:GetFullName(),
                type   = method,
                args   = args,
            }
            table.insert(RemoteSpy.Log, 1, entry)
            if #RemoteSpy.Log > RemoteSpy.Max then
                table.remove(RemoteSpy.Log)
            end
            -- Push to spy tab label if GUI exists and spy is ON
            if _G.BH_RemoteSpy and _G.BH_SpyCallback then
                pcall(_G.BH_SpyCallback, entry)
            end
        end
        return old_namecall(self, ...)
    end
    setreadonly(mt, true)
end

